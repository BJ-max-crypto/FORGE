# Demo mode is the default. Leave these blank to keep data in this browser only.
# Do not put the Supabase service role key in any NEXT_PUBLIC_ variable.

# Supabase — enables the hosted adapter. Requires a signed-in Supabase user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by the push subscription and dispatch routes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Clerk is not wired in this build. Add @clerk/nextjs when you have a project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Web Push. Both keys are required before background notifications can be sent.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bearer token required by POST/GET /api/push/dispatch
CRON_SECRET=
